# Proxy Configuration
# IMPORTANT: ProxyMesh Free Trial only provides datacenter IPs which are blocked by Footlocker
# You need residential IPs for successful scraping

# RECOMMENDED SOLUTION: ScraperAPI Ultra Premium (Required for Footlocker)
# 1. Sign up at: https://www.scraperapi.com
# 2. Get your API key from dashboard  
# 3. Add it below and restart your GCP deployment
# NOTE: Footlocker requires Ultra Premium proxies (10x cost: ~$1-2 per 1000 requests)
# Regular ScraperAPI won't work - Footlocker is heavily protected
# SCRAPERAPI_KEY=your_scraperapi_key_here

# Alternative 1: ProxyMesh (Upgrade to paid residential plan - $10-50/month)
# The free trial you're currently using only has datacenter IPs
# Contact ProxyMesh to upgrade to residential proxy plan
# PROXYMESH_USER=your_username
# PROXYMESH_PASS=your_password

# Alternative 2: Bright Data (Enterprise grade - $500+/month)
# Most reliable but expensive
# BRIGHTDATA_HOST=zproxy.lum-superproxy.io
# BRIGHTDATA_PORT=22225
# BRIGHTDATA_USER=your_username
# BRIGHTDATA_PASS=your_password

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/dbname

# Application Configuration
DISABLE_HTML_DESCRIPTION=true